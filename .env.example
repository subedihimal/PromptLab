# Groq API key used by the OpenAI-compatible client
AI_API_KEY=your_groq_api_key

# Tavily API key used for web search and trusted-source extraction
TAVILY_API_KEY=your_tavily_api_key

# Secret used by Vercel to authorize the daily CV cache refresh
CRON_SECRET=replace_with_a_random_secret_at_least_16_characters_long
